# ==============================================================================
# SafeWorkspace Agent - Environment Configuration Template
# Copy this file to `.env` in the project root (or `backend/.env`) and customize.
# All LLM credentials can also be configured at runtime via the Web UI (BYOK).
# ==============================================================================

# OpenAI-compatible API Key (supports OpenAI, DeepSeek, OpenRouter, Ollama, vLLM, etc.)
OPENAI_API_KEY=sk-your-api-key-here

# OpenAI-compatible Base URL (leave default for official OpenAI API)
OPENAI_BASE_URL=https://api.openai.com/v1

# Model name to use for file organization reasoning
MODEL_NAME=gpt-4o-mini

# Absolute or relative path to the strict sandbox root directory.
# The agent has ZERO access outside this directory.
SANDBOX_ROOT=./demo_sandbox

# Optional server & agent tuning
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_AGENT_STEPS=25
L1_MAX_DEPTH=4
L1_MAX_ENTRIES=400
L2_MAX_CHARS=1800
L3_MAX_CHARS=8000
